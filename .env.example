# AI 翻译端点（OpenAI 兼容 /chat/completions）
# 本地运行 scripts/fetch.mjs 时读取 .env.local（已 gitignore）；
# GitHub Actions 中同名变量配置在 repo Secrets 里。
# ⚠ 示例文件只放占位符 —— 此前写入了真实内网端点与 Key（已泄露,请轮换）。
TRANSLATE_BASE_URL=https://your-llm-proxy.example.com/v1
TRANSLATE_API_KEY=sk-your-key-here
TRANSLATE_MODEL=your-model-name

# Vercel AI proxy allows common providers by default. Add exact hostnames for
# custom public HTTPS providers (never include schemes, paths, or wildcards).
# AI_PROXY_ALLOWED_HOSTS=llm.example.com,api.your-company.example

# 可选调优
# TRANSLATE_CONCURRENCY=4      # 翻译并发数
# TRANSLATE_LIMIT=0            # 单次运行最多翻译题数（0=不限）
# ABC_SCAN=3                   # CI 扫描最近 N 场 ABC
# CF_SCAN=3                    # CI 扫描最近 N 场 CF
# BACKFILL=10                  # 每次 CI 回填的历史题面数
