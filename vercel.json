{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/build-index.mjs && node scripts/fetch-runtime.mjs && next build",
  "ignoreCommand": "git log -1 --pretty=%s | grep -q '\\[vercel skip\\]'",
  "git": {
    "deploymentEnabled": {
      "ci-logs": false
    }
  }
}
